<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 프로젝트에 맞게 수정  -->
<mapper namespace="mybatis.mapper.KkoAtTmplMapper">
    <cache/>

    <select id="getTmplSearchLst" resultType="Tblmi_comm_cdDto" parameterType="Tblmi_comm_cdDto">
        SELECT * FROM tblmi_comm_cd
        WHERE GRP_ID = #{grp_id}
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(cd_id)">
                and cd_id = #{cd_id}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(cd_val)">
                and cd_val = #{cd_val}
            </if>
            AND USE_YN = 'Y'
        ORDER BY CD_SN
    </select>

    <select id="selTotalAtTmplCnt" resultType="Integer" parameterType="AtTmpl_searchDto">
        SELECT COUNT(*) FROM tblmi_kko_at_tmpl AS a
            INNER JOIN tblmi_set_lst AS b
                    ON a.SEND_KEY = b.LIST_VAL
                    AND b.use_yn ='Y'
        <where>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(send_key)">
                and a.send_key = #{send_key}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(tmpl_nm)">
                and a.tmpl_nm = #{tmpl_nm}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(ex_tmpl_nm)">
                and a.tmpl_nm like CONCAT('%',  #{ex_tmpl_nm},'%')
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(chan_id)">
                and a.chan_id = #{chan_id}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(kep_status)">
                and a.kep_status = #{kep_status}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(use_yn)">
                and a.use_yn = #{use_yn}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(tmpl_status)">
                and a.tmpl_status = #{tmpl_status}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(reg_dt)">
                <choose>
                    <when test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(reg_dt_range)">
                        and a.reg_dt <![CDATA[ > ]]> #{reg_dt}   and a.reg_dt <![CDATA[ < ]]> #{reg_dt_range}
                    </when>
                    <otherwise>and a.reg_dt = #{reg_dt}</otherwise>
                </choose>
            </if>

            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(usr_grp_cd)">
                and b.usr_grp_cd = #{usr_grp_cd}
            </if>
        </where>
    </select>

    <select id="selAtTmplLst" resultType="Tblmi_kko_at_tmplDto" parameterType="AtTmpl_searchDto">
        SELECT * FROM tblmi_kko_at_tmpl AS a
            INNER JOIN tblmi_set_lst AS b
                    ON a.SEND_KEY = b.LIST_VAL
                        AND b.use_yn ='Y'
        <where>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(send_key)">
                and a.send_key = #{send_key}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(tmpl_nm)">
                and a.tmpl_nm = #{tmpl_nm}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(ex_tmpl_nm)">
                and a.tmpl_nm like CONCAT('%',  #{ex_tmpl_nm},'%')
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(chan_id)">
                and a.chan_id = #{chan_id}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(kep_status)">
                and a.kep_status = #{kep_status}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(use_yn)">
                and a.use_yn = #{use_yn}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(tmpl_status)">
                and a.tmpl_status = #{tmpl_status}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(reg_dt)">
                <choose>
                    <when test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(reg_dt_range)">
                        and a.reg_dt <![CDATA[ > ]]> #{reg_dt}   and a.reg_dt <![CDATA[ < ]]> #{reg_dt_range}
                    </when>
                    <otherwise>and a.reg_dt = #{reg_dt}</otherwise>
                </choose>
            </if>

            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(usr_grp_cd)">
                and b.usr_grp_cd = #{usr_grp_cd}
            </if>
        </where>
        order by a.REG_DT DESC
        <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(firstIndex)">
            LIMIT #{firstIndex, javaType=int}, #{recordCountPerPage, javaType=int}
        </if>
    </select>

    <select id="selKkoAtTmpl" resultType="Tblmi_kko_at_tmplDto"  parameterType="AtTmpl_searchDto">
        SELECT * FROM tblmi_kko_at_tmpl
        <where>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(send_key)">
                and send_key = #{send_key}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(tmpl_nm)">
                and tmpl_nm = #{tmpl_nm}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(tmpl_cd)">
                and tmpl_cd = #{tmpl_cd}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(chan_id)">
                and chan_id = #{chan_id}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(kep_status)">
                and kep_status = #{kep_status}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(use_yn)">
                and use_yn = #{use_yn}
            </if>
            <if test="!@com.omnilab.micrm.common.CommonUtils@isEmptyObject(tmpl_status)">
                and tmpl_status = #{tmpl_status}
            </if>
        </where>
    </select>
</mapper>




