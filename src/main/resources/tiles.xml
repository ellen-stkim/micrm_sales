<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE tiles-definitions PUBLIC  "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
        "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">
<tiles-definitions>
    <!-- main -->
    <definition name="main-layout" template="/WEB-INF/layout/decorator-index.jsp">
        <put-attribute name="head" value="/WEB-INF/layout/base-header.jsp"/>
        <put-attribute name="header" value="/WEB-INF/layout/base-body-header.jsp"/>
        <put-attribute name="menu" value="/WEB-INF/layout/base-menu.jsp"/>
        <put-attribute name="body" value=""/>
    </definition>

    <definition name="index" template="/WEB-INF/views/index.jsp">
        <put-attribute name="head" value="/WEB-INF/layout/base-header.jsp"/>
        <put-attribute name="menu" value="/WEB-INF/layout/base-menu.jsp"/>
    </definition>

    <!-- Home -->
    <definition name="home" extends="main-layout">
        <put-attribute name="body" value="/WEB-INF/views/home.jsp"/>
    </definition>

    <!-- salesforce -->
    <definition name="cont/salesforce" template="/WEB-INF/layout/decorator-salesforce.jsp">
        <put-attribute name="head" value="/WEB-INF/layout/base-header.jsp"/>
        <put-attribute name="body" value="/WEB-INF/views/cont/salesforce.jsp"/>
    </definition>

    <!-- default -->
    <definition name="*/*" extends="main-layout">
        <put-attribute name="body" value="/WEB-INF/views/{1}/{2}.jsp"/>
    </definition>

    <definition name="*/*/*" extends="main-layout">
        <put-attribute name="body" value="/WEB-INF/views/{1}/{2}/{3}.jsp"/>
    </definition>

</tiles-definitions>