.test_tbl .custom_radio {margin-right:15px;}

/* loading bar */
#loading {background:rgba(255,255,255,0.5); z-index:9999;}

/* 알림 */
.side_notice {position:fixed; right:-398px; top:0; z-index:999; width:398px;
    height:100%;  background:#FFFFFF; border-left:1px solid #aaaaaa;
    transition:right 0.5s ease-in;}
.side_notice.active {right:0;}
.side_notice .top {height:72px; padding:0 40px 0 20px; position:relative;}
.side_notice .top h3 {float:left; font-size:14px; font-weight:700; line-height:72px;
    padding-left:20px; background: url('../image/ico_notice2.png') no-repeat left center;
    margin-right:20px;}
.side_notice .top p  {float:left; line-height:72px; color:#bbbbbb;}
.side_notice .top .side_close {position:absolute; right:20px; top:50%; width:12px;
    height:12px; background:url('../image/ico_close1.png') no-repeat center; margin-top:-6px;
    cursor:pointer; z-index:10;}
.side_notice .row {padding:0 40px 0 20px; border-bottom:1px solid #f4f4f4;
    background:#fbfbfb; position:relative;}
.side_notice .row h4 {float:left; line-height:35px; margin-right:22px;}
.side_notice .row p {float:left; line-height:35px; color:#bbbbbb;}
.side_notice .row .refresh {position:absolute; right:20px; top:50%;
    width:13px; height:12px; background: url('../image/ico_btn14.png') center;
    margin-top:-7px; cursor:pointer; overflow:hidden;}
.side_notice .body_list {width:100%;}
.side_notice .body_list.middle {height:calc(100% - 408px); overflow-y:auto; overflow-x:hidden;}
.side_notice .body_list .article {padding:16px 20px; border-bottom:1px solid #f4f4f4;
    min-height:70px;}
.side_notice .body_list .article .date {font-size: 11px; color:#bbbbbb; margin-bottom:6px;}
.side_notice .body_list .article .notice_txt {line-height:1.6; width: 100%;
    word-break: break-all;}
.side_notice .body_list .article .notice_txt img {vertical-align: middle;}
.side_notice .bottom .body_list {height:211px; overflow-y:auto; overflow-x: hidden;}
.side_notice .bottom .row_mail {display:block; width:100%; line-height:53px; text-align:center; color:#bbbbbb; border-top:1px solid #f4f4f4;
    background:#fafafa url('../image/ico_sms4.png') no-repeat 110px center;}



