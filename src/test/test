.popup_size2 {width:1200px;}
.popup_size3 {width:340px;}
.popup_size4 {width:700px;}
.popup_size5 {width:900px;}
.popup_size6 {width:1100px;}
.popup_size7 {width:660px;}
.popup_size8 {width:1280px;}

.btn_pop_close {position:absolute; right:15px; top:15px; width:12px; height:12px;background:url('../image/btn_close1.png') no-repeat center; text-indent:-999px; overflow:hidden; cursor:pointer;z-index:10;}
.btn_pop_close.sm{width: 8px; height: 8px; right: 10px; top: 10px;}
.pop_title {font-size:14px;; height:41px; line-height:40px; text-align:center;background:#fafafa; border-bottom:1px solid #dddddd;}
.pop_title .bar {font-size:14px; color:#e6e6e6; vertical-align:1px; margin:0 10px;}
.pop_inner {padding:30px;}
.pop_inner.padding_none {padding:0;}
.pop_margin_bttm {margin-bottom:30px;}
.pop_table {width:100%; border-top:1px solid #dddddd;}
.pop_table th {height:35px; background:#fafafa; text-align:left; padding-left:20px;}
.pop_table td {height:35px; text-align:left; padding-left:20px; word-break: break-word; line-height:1.3;}
.pop_table tr {border-bottom:1px solid #f4f4f4;}
.pop_table tbody tr:last-child {border-bottom:1px solid #dddddd;}

.dis_flex {display: flex;}
.pop_inner .camp-report .form_search{width:100%; display:flex; justify-content:center; margin-bottom:30px; position:relative;flex-direction: column;}

.pop_table .custom_radio {vertical-align:top;}
.pop_table .custom_radio span {top:-2px;}
.pop_error_txt {min-height:32px; color:#cccccc; padding:10px 0; text-align:right;}

.pop_table_type1 {width:100%; border-top:1px solid #dddddd;}
.pop_table_type1 th {height:35px; background:#fafafa; text-align:center; color:#999999; border-right:1px solid #f4f4f4;}
.pop_table_type1 td {height:35px; text-align:left; padding:7px 0; line-height:1.6;}
.pop_table_type1 tr {border-bottom:1px solid #f4f4f4;}
.pop_table_type1 tbody tr:last-child {border-bottom:1px solid #dddddd;}

.pop_table_type1 .custom_radio {vertical-align:middle; margin-left:15px;}

.popup_title {color:#444444; font-weight:700; margin-bottom:12px;}

.pop_table_type2 {width:100%;}
.pop_table_type2 th,
.pop_table_type2 td {text-align:center;}
.pop_table_type2 th {width: 25%; height:37px; background:#fafafa; border:1px solid #dddddd;}
.pop_table_type2 td {height:37px; font-size:11px; border:1px solid #dddddd;}

.pop_table_type3 {width:100%; border-top:1px solid #dddddd; /*table-layout: fixed;*/}
.pop_table_type3 th {height:35px; background:#fafafa; text-align:left; padding-left:20px; line-height:1.2;}
.pop_table_type3 td {height:35px; text-align:left; padding-left:20px; word-break:break-all; line-height:1.3;}
.pop_table_type3 tr {border-bottom:1px solid #f4f4f4;}
.pop_table_type3 tbody tr:last-child {border-bottom:1px solid #dddddd;}
.pop_table_type3 tr.no_data td {height:175px; text-align:center; padding:0;}

