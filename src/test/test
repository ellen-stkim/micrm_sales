.pop_tap_nav {margin-left:-30px; margin-bottom:30px; position:relative;}
.pop_tap_nav::before {content:''; display:block; width:calc(100% + 30px); height:1px; position:absolute; left:0; top:36px;
    background:#dddddd;}
.pop_tap_nav li {float:left; width:150px; height:37px; line-height:37px; text-align:center; position:relative; z-index:100;
    background:#fafafa; border:1px solid #dddddd;border-left:none;cursor:pointer;}
.pop_tap_nav li.on {font-weight:700; color:#618cd3; background:#FFFFFF; border-bottom:1px solid #FFFFFF;}

.tap_contents {display:none;}
.tap_contents.on {display:block;}

.pop_section {padding-bottom:30px; border-bottom:1px solid #f4f4f4; margin-bottom:30px; position:relative;}

.form_search {width:100%; display:flex; flex-direction:row; justify-content:center; margin-bottom:30px; position:relative;}
.form_search .calendar {width:136px; height:37px; border:1px solid #dddddd;
    padding:0 24px 0 11px; background:url('../image/ico_calendar.png') no-repeat 112px center;
    font-family:"Gotham", sans-serif;}
.form_search .hyphen {line-height:37px; margin:0 4px; font-size:20px; color:#dddddd;}
.form_search .hyphen::before {content:''; display:inline-block; width:6px; height:1px; background:#dddddd;
    vertical-align:middle;}
.form_search .input_txt {width:284px; height:37px; border:1px solid #dddddd;}
/*.form_search .input_txt {width: 65%; margin-right: 9px;}*/
.form_search .input_txt input[type="text"] {float:left; width:247px; height:100%; padding:0 10px;}
.form_search .input_txt .btn_search {float:left; width:35px; height:100%; background:url('../image/ico_search.png') no-repeat center;
    text-indent:-999px; overflow:hidden; cursor:pointer;}
.alert_txt {text-align:center; margin-bottom:10px; line-height:1.5;}

/* 공지사항 팝업 */
.noticePopup .scroll_wrap {max-height:600px;}
.noticePopup h3 {font-size:16px; font-weight:700; text-align:center; color:#222222; padding:0 0 30px 0;
    margin:0 10px;
    border-bottom:1px solid #f4f4f4;}
.noticePopup p {margin-top:30px;color:#666666; line-height:1.6;}
.noticePopup .section_box {width:100%; border:1px solid #dddddd; background:#fafafa; margin-top:30px;}
.noticePopup .section_box .top {line-height:35px; text-align:center; border-bottom:1px solid #f4f4f4;}
.noticePopup .section_box .body {padding:20px;}
.noticePopup .section_box .body .list_txt {color:#618cd3; line-height:1.6; margin-bottom:30px;}
.noticePopup .section_box .body .color_gray {color:#bbbbbb;}
.today {position:absolute; bottom:-26px; width:100%; left:0;}
.today .custom_check1 {padding-left:25px; line-height:15px; color:#cccccc;}

/* 삭제안내 팝업 */
.deletePopup .password_input,
.allDeletePopup .password_input {width:100%; height:37px; padding:0 10px;}

/* table row tab */
.tab_row {float:left; width:100%; height:35px; margin-top:-1px; border-bottom:1px solid #aaaaaa;
    position:relative; z-index:10;}
.tab_row::after {content:''; display:block; clear:both;}
.tab_row li,
.tab_row div {float:left; height:34px; line-height:34px; background:#FFFFFF;
    border-top:1px solid #dddddd; border-right:1px solid #f4f4f4; color:#cccccc;}
.tab_row div.on,
.tab_row li.on {height:35px; border-top:1px solid #aaaaaa; border-right:1px solid #aaaaaa; border-left:1px solid #aaaaaa;}
.tab_row div:first-child.on,
.tab_row li:first-child.on {border-left:none;}
.tab_row div a,
.tab_row li a,
.tab_row li > span {display:block; width:100%; height:100%; padding:0 20px; color:#cccccc; cursor:pointer;}
.tab_row div.on,
.tab_row div.on a,
.tab_row li.on a,
.tab_row li.on > span {color:#666666;}
.tab_row div a {padding:0;}
.tab_row div {padding:0 20px;}

